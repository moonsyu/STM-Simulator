{
  "name": "stm-simulator",
  "version": "1.46.4",
  "description": "STM32 learning IDE with an integrated circuit simulator and Cortex-M firmware emulator",
  "author": "moonsyu",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run build:editor && electron .",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/interp/*.test.js\" \"tests/emu/*.test.js\" \"tests/firmware/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:interp": "node --test \"tests/interp/*.test.js\"",
    "test:emu": "node --test \"tests/emu/*.test.js\"",
    "test:firmware": "node --test \"tests/firmware/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:toolchain": "node --test --test-concurrency=1 \"tests/toolchain/*.test.mjs\"",
    "test:release": "node --test --test-concurrency=1 \"tests/release/*.test.mjs\"",
    "build": "npm run build:editor && npm run build:package",
    "build:package": "node scripts/clean-build.cjs && node scripts/build-package.cjs",
    "build:artifact": "node scripts/prepare-artifact.cjs",
    "build:editor": "node scripts/build-editor.mjs",
    "lint": "eslint .",
    "build:icon": "electron scripts/prepare-icon.cjs",
    "build:catalog": "node scripts/build-device-catalog.mjs && node scripts/build-device-reference.mjs && node scripts/build-model-gallery.mjs",
    "build:fixtures": "node scripts/emu/build-cpu-fixtures.mjs && node scripts/emu/build-firmware-fixtures.mjs",
    "dev:web": "node scripts/serve.cjs",
    "postinstall": "npm run build:editor",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/github-reporter.mjs --test-reporter-destination=stdout \"tests/unit/*.test.js\" \"tests/interp/*.test.js\" \"tests/emu/*.test.js\" \"tests/firmware/*.test.js\"",
    "test:e2e:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/github-reporter.mjs --test-reporter-destination=stdout --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:toolchain:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/github-reporter.mjs --test-reporter-destination=stdout --test-concurrency=1 \"tests/toolchain/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dompurify": "3.4.17",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "monaco-editor": "0.57.0",
    "playwright": "1.64.1"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "global-agent": "4.1.3",
    "@electron/asar": {
      ".": "4.3.1",
      "glob": "14.0.3"
    },
    "@electron/universal": "3.0.6",
    "minimatch": "11.0.3"
  },
  "build": {
    "appId": "local.stm32.circuitlab",
    "productName": "STM Simulator",
    "directories": {
      "output": "work/build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/COPYRIGHT-REVIEW.md",
      "docs/APP-ICON.md",
      "docs/SKETCH-API.md",
      "docs/HAL-API.md",
      "docs/IDE.md",
      "docs/MCU-DEFAULTS.md",
      "docs/UPDATES.md",
      "docs/DEVICE-DOCS.md",
      "docs/DIAGNOSTICS.md",
      "docs/DEVICE-CATALOG.md",
      "docs/device-model-gallery.html",
      "docs/DEVICE-VISUAL-REFERENCES.md",
      "docs/device-reference-gallery.html",
      "docs/device-visual-references.json",
      "docs/architecture/EMULATOR.md"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "desktop/icons/stm-simulator.ico"
    },
    "portable": {
      "artifactName": "STM-Simulator.exe"
    }
  }
}
