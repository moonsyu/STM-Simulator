{
  "name": "stm-simulator",
  "version": "0.9.0",
  "description": "NUCLEO-F446RE circuit and GPIO simulator",
  "author": "STM Simulator",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/clean-build.cjs && electron-builder --win portable --x64 --publish never",
    "build:artifact": "node scripts/prepare-artifact.cjs",
    "dev:web": "node scripts/serve.cjs",
    "test:ui": "node scripts/ui-smoke.cjs && node scripts/editor-smoke.cjs && node scripts/parts-smoke.cjs && node scripts/features-smoke.cjs && node scripts/hal-smoke.cjs && node scripts/layout-serial-smoke.cjs && node scripts/hal-examples-smoke.cjs && node scripts/boards-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "local.stm32.circuitlab",
    "productName": "STM Simulator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/COPYRIGHT-REVIEW.md",
      "docs/SKETCH-API.md",
      "docs/HAL-API.md"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "STM-Simulator-${version}-win-x64.exe"
    }
  }
}
