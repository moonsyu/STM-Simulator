{
  "name": "stm-simulator",
  "version": "0.21.2",
  "description": "STM32 learning IDE with integrated circuit simulation",
  "author": "STM Simulator",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run build:editor && electron .",
    "test": "node --test tests/*.test.js",
    "test:passive-buzzer": "node --test tests/passive-buzzer.test.js",
    "test:passive-buzzer:ui": "node scripts/passive-buzzer-smoke.cjs",
    "build": "npm run build:editor && node scripts/clean-build.cjs && electron-builder --win portable --x64 --publish never",
    "build:artifact": "node scripts/prepare-artifact.cjs",
    "dev:web": "node scripts/serve.cjs",
    "test:ui": "node scripts/ui-smoke.cjs && node scripts/editor-smoke.cjs && node scripts/parts-smoke.cjs && node scripts/features-smoke.cjs && node scripts/hal-smoke.cjs && node scripts/layout-serial-smoke.cjs && node scripts/hal-examples-smoke.cjs && node scripts/boards-smoke.cjs && node scripts/devices-smoke.cjs && node scripts/circuit-tools-smoke.cjs && node scripts/editor-tools-smoke.cjs && node scripts/passive-buzzer-smoke.cjs && node scripts/l298n-smoke.cjs && node scripts/ide-smoke.cjs && node scripts/mcu-defaults-smoke.cjs",
    "test:main-c": "node scripts/check-main-c.mjs",
    "build:icon": "electron scripts/prepare-icon.cjs",
    "test:l298n": "node --test tests/l298n.test.js",
    "test:l298n:ui": "node scripts/l298n-smoke.cjs",
    "build:editor": "node scripts/build-editor.mjs",
    "postinstall": "npm run build:editor",
    "test:ide:ui": "node scripts/ide-smoke.cjs",
    "test:native": "node scripts/native-ide-check.cjs",
    "test:native:ui": "node scripts/native-ide-smoke.cjs",
    "test:arm-gdb": "node scripts/arm-gdb-check.cjs",
    "test:mcu-defaults:ui": "node scripts/mcu-defaults-smoke.cjs",
    "test:updates:ui": "node scripts/update-smoke.cjs",
    "test:appearance:ui": "node scripts/appearance-smoke.cjs",
    "test:resize:ui": "node scripts/resize-ui-check.cjs",
    "test:part-previews:ui": "node scripts/part-preview-ui-check.cjs",
    "test:contrast:ui": "node scripts/ui-contrast-check.cjs",
    "test:colorscheme:ui": "node scripts/colorscheme-smoke.cjs",
    "test:device-docs:ui": "node scripts/device-docs-smoke.cjs",
    "test:device-docs:arm": "node scripts/device-docs-arm-check.cjs",
    "build:catalog": "node scripts/build-device-catalog.mjs && node scripts/build-model-gallery.mjs",
    "test:catalog:ui": "node scripts/catalog-ui-check.cjs",
    "test:catalog:arm": "node scripts/catalog-arm-check.cjs",
    "test:uart:ui": "node scripts/uart-vcp-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "monaco-editor": "0.57.0",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "local.stm32.circuitlab",
    "productName": "STM Simulator",
    "directories": {
      "output": "work/build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/COPYRIGHT-REVIEW.md",
      "docs/APP-ICON.md",
      "docs/SKETCH-API.md",
      "docs/HAL-API.md",
      "docs/IDE.md",
      "docs/MCU-DEFAULTS.md",
      "docs/UPDATES.md",
      "docs/DEVICE-DOCS.md",
      "docs/DEVICE-CATALOG.md",
      "docs/device-model-gallery.html",
      "docs/DEVICE-VISUAL-REFERENCES.md",
      "docs/device-reference-gallery.html",
      "docs/device-visual-references.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "desktop/icons/stm-simulator.ico"
    },
    "portable": {
      "artifactName": "STM-Simulator.exe"
    }
  }
}
